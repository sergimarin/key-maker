---
import Password from "../components/Password.astro";
import Options from "../components/Options.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <div class="min-h-dvh grid md:grid-cols-[1.25fr_1fr]">
        <section id="result" class="panel flex flex-col justify-between p-6 sm:p-12" data-level="0" aria-label="Contraseña">
            <p class="font-semibold text-lg flex items-center gap-2">Key Maker <span class="version">v2.0</span></p>
            <div class="my-12">
                <Password />
            </div>
            <div class="strength">
                <div class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
                <p class="strength-text">
                    <span class="strength-label">Seguridad</span>
                    <span id="security-indicator" role="status"></span>
                </p>
                <p id="entropy" class="entropy"></p>
            </div>
        </section>

        <section class="p-6 sm:p-12 flex flex-col justify-center" aria-label="Opciones de personalización">
            <Options />
        </section>
    </div>
</Layout>

<script>
    import { Notyf } from "notyf";
    import "notyf/notyf.min.css";
    import { WORDS } from "../data/words";

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    const length = $<HTMLInputElement>("length");
    const lengthValue = $("lengthValue");
    const wordcount = $<HTMLInputElement>("wordcount");
    const wordcountValue = $("wordcountValue");
    const password = $("password");
    const result = $("result");
    const indicator = $("security-indicator");
    const entropyEl = $("entropy");
    const charsOpts = $("chars-opts");
    const wordsOpts = $("words-opts");
    const notyf = new Notyf();

    const SETS: Record<string, string> = {
        uppercase: "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
        lowercase: "abcdefghijklmnopqrstuvwxyz",
        numbers: "0123456789",
        symbols: "!@#$%^&*()_+[]{}|;:,.<>?",
    };
    const AMBIGUOUS = /[O0oIl1|]/g;
    const GUESSES_PER_SECOND = 1e10;

    let current = "";

    const checked = (id: string) => $<HTMLInputElement>(id).checked;
    const mode = () => (document.querySelector("input[name=mode]:checked") as HTMLInputElement).value;

    document.querySelector("section[aria-label='Opciones de personalización']")!.addEventListener("input", () => {
        lengthValue.textContent = length.value;
        wordcountValue.textContent = wordcount.value;
        const words = mode() === "words";
        charsOpts.hidden = words;
        wordsOpts.hidden = !words;
        generate();
    });

    $("regenerate").addEventListener("click", generate);
    $("copy").addEventListener("click", copy);

    document.addEventListener("keydown", (e) => {
        if (e.ctrlKey || e.metaKey || e.altKey || e.repeat) return;
        const t = e.target as HTMLElement;
        if (t.closest("input, select, textarea, button")) return;
        const k = e.key.toLowerCase();
        if (k === " " || k === "r") {
            e.preventDefault();
            generate();
        } else if (k === "c") {
            copy();
        }
    });

    generate();

    async function copy() {
        if (!current) return;
        try {
            await navigator.clipboard.writeText(current);
            notyf.success("¡Copiada correctamente!");
        } catch {
            notyf.error("No se pudo copiar la contraseña");
        }
    }

    function randomInt(max: number): number {
        const limit = Math.floor(0x100000000 / max) * max;
        const buf = new Uint32Array(1);
        do {
            crypto.getRandomValues(buf);
        } while (buf[0] >= limit);
        return buf[0] % max;
    }

    function shuffle<T>(arr: T[]): T[] {
        for (let i = arr.length - 1; i > 0; i--) {
            const j = randomInt(i + 1);
            [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        return arr;
    }

    type Made = { value: string; bits: number };

    function makeChars(): Made | null {
        const strip = (s: string) => (checked("ambiguous") ? s.replace(AMBIGUOUS, "") : s);
        const pools = Object.keys(SETS)
            .filter(checked)
            .map((id) => strip(SETS[id]));
        if (!pools.length) return null;

        const all = pools.join("");
        const n = Number(length.value);
        // Un carácter de cada tipo marcado, el resto del conjunto completo.
        const out = pools.map((p) => p[randomInt(p.length)]);
        while (out.length < n) out.push(all[randomInt(all.length)]);

        return { value: shuffle(out).slice(0, n).join(""), bits: n * Math.log2(all.length) };
    }

    function makeWords(): Made {
        const n = Number(wordcount.value);
        const cap = checked("capitalize");
        const words: string[] = [];
        for (let i = 0; i < n; i++) {
            const w = WORDS[randomInt(WORDS.length)];
            words.push(cap ? w[0].toUpperCase() + w.slice(1) : w);
        }
        let bits = n * Math.log2(WORDS.length);
        if (checked("addnumber")) {
            words.push(String(randomInt(100)).padStart(2, "0"));
            bits += Math.log2(100);
        }
        const sep = $<HTMLSelectElement>("separator").value;
        return { value: words.join(sep), bits };
    }

    function generate() {
        const made = mode() === "words" ? makeWords() : makeChars();

        if (!made) {
            current = "";
            password.textContent = "Elige al menos un tipo de carácter";
            password.classList.add("empty");
            setStrength(0, "", "");
            return;
        }

        current = made.value;
        password.classList.remove("empty");
        renderPassword(made.value);
        evaluate(made.bits);
    }

    function renderPassword(value: string) {
        const frag = document.createDocumentFragment();
        for (const ch of value) {
            const span = document.createElement("span");
            span.className = /[A-Za-z]/.test(ch) ? "" : /\d/.test(ch) ? "d" : "s";
            span.textContent = ch;
            frag.appendChild(span);
        }
        password.replaceChildren(frag);
    }

    function setStrength(level: number, label: string, detail: string) {
        result.dataset.level = String(level);
        indicator.textContent = label;
        entropyEl.textContent = detail;
    }

    function evaluate(bits: number) {
        const level = bits < 40 ? 1 : bits < 60 ? 2 : bits < 80 ? 3 : 4;
        const label = ["", "Débil", "Normal", "Fuerte", "Muy segura"][level];
        setStrength(level, label, `${Math.round(bits)} bits · ${crackTime(bits)}`);
    }

    // Tiempo medio para dar con la clave probando GUESSES_PER_SECOND intentos por segundo.
    function crackTime(bits: number): string {
        const seconds = Math.pow(2, bits - 1) / GUESSES_PER_SECOND;
        const units: [number, string, string][] = [
            [60, "segundo", "segundos"],
            [60, "minuto", "minutos"],
            [24, "hora", "horas"],
            [365, "día", "días"],
            [1000, "año", "años"],
        ];
        if (seconds < 1) return "se rompería al instante";
        let v = seconds;
        for (let i = 0; i < units.length; i++) {
            const [step] = units[i];
            if (v < step || i === units.length - 1) {
                if (i === units.length - 1 && v >= 1e9) return "se rompería en más de mil millones de años";
                if (i === units.length - 1 && v >= 1e6) return "se rompería en millones de años";
                const r = Math.round(v);
                return `se rompería en ${r.toLocaleString("es-ES")} ${r === 1 ? units[i][1] : units[i][2]}`;
            }
            v /= step;
        }
        return "";
    }
</script>
